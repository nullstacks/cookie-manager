{
  "manifest_version": 3,
  "name": "Cookie Manager",
  "version": "1.2.1",
  "description": "View, add, edit, delete, import and export cookies for the current site.",
  "permissions": ["cookies", "clipboardWrite", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Cookie Manager",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
